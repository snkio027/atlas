{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "operator-control",
        "namespace": "kafka"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 443,
                "protocol": "TCP"
              },
              {
                "port": 6443,
                "protocol": "TCP"
              }
            ]
          },
          {
            "ports": [
              {
                "port": 9091,
                "protocol": "TCP"
              },
              {
                "port": 9093,
                "protocol": "TCP"
              },
              {
                "port": 9090,
                "protocol": "TCP"
              },
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "podSelector": {
                  "matchLabels": {}
                }
              }
            ]
          }
        ],
        "ingress": [],
        "podSelector": {
          "matchLabels": {
            "strimzi.io/kind": "cluster-operator"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    }
  ],
  "kind": "List"
}
