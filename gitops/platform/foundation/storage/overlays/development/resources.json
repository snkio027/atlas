{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "labels": {
          "atlas.local/owner": "platform",
          "pod-security.kubernetes.io/enforce": "restricted"
        },
        "name": "object-storage"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "platform-budget",
        "namespace": "object-storage"
      },
      "spec": {
        "hard": {
          "limits.memory": "8Gi",
          "persistentvolumeclaims": "8",
          "pods": "32",
          "requests.cpu": "3",
          "requests.memory": "4Gi",
          "requests.storage": "32Gi"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "name": "defaults",
        "namespace": "object-storage"
      },
      "spec": {
        "limits": [
          {
            "default": {
              "memory": "256Mi"
            },
            "defaultRequest": {
              "cpu": "10m",
              "memory": "32Mi"
            },
            "type": "Container"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "s3-default-deny",
        "namespace": "object-storage"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "s3-clients",
        "namespace": "object-storage"
      },
      "spec": {
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "workload-web"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "atlas.local/s3-client": "true"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8333,
                "protocol": "TCP"
              }
            ]
          },
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "monitoring"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "prometheus"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 9324,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "seaweedfs"
          }
        },
        "policyTypes": [
          "Ingress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "s3-client-egress",
        "namespace": "workload-web"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 8333,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "object-storage"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "seaweedfs"
                  }
                }
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "atlas.local/s3-client": "true"
          }
        },
        "policyTypes": [
          "Egress"
        ]
      }
    }
  ],
  "kind": "List"
}
