#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

if ((BASH_VERSINFO[0] < 5)); then
  printf 'Atlas Recovery requires Bash 5.x; found %s\n' "$BASH_VERSION" >&2
  exit 2
fi

ATLAS_RECOVERY_ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
readonly ATLAS_RECOVERY_ROOT_DIR
readonly ATLAS_RECOVERY_CLI_VERSION=0.1.0

# Recovery code is intentionally sourced only by this entry point. The normal
# Bootstrap CLI must remain unable to dispatch recovery behavior.
# shellcheck source=bootstrap/recovery/audit-config.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/audit-config.sh"
# shellcheck source=bootstrap/recovery/admission-canary/render.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/admission-canary/render.sh"

recovery::usage() {
  cat << 'EOF'
Usage: bootstrap/recovery/atlas-recovery <command> [options]

Commands:
  phase0 audit-config                 Render an audited Kind configuration
  phase0 admission-canary-manifests  Render the admission escape canary bundle

Options for phase0 audit-config:
  --audit-dir <path>  Existing writable audit directory outside the repository

Options for phase0 admission-canary-manifests:
  --recovery-operator <username>
                      Exact atlas:break-glass:<kube-system-UID>:g<N> username

Global options:
  -V, --version        Show the Recovery CLI version
  -h, --help           Show this help

This Phase-0 entry point renders definitions only. It cannot create a cluster,
issue credentials, install RBAC or Admission resources, or perform recovery
mutations.
EOF
}

recovery::version() {
  printf 'atlas-recovery %s\n' "$ATLAS_RECOVERY_CLI_VERSION"
}

recovery::die() {
  printf 'atlas-recovery: %s\n' "$*" >&2
  return 1
}

recovery::dispatch_phase0() {
  local action=${1:-}
  [[ -n $action ]] || {
    recovery::die "phase0 requires an action"
    return 2
  }
  shift

  case "$action" in
    audit-config)
      audit::dispatch "$action" "$@"
      ;;
    admission-canary-manifests)
      admission_canary::dispatch "$@"
      ;;
    *)
      recovery::die "unknown phase0 action: ${action}"
      return 2
      ;;
  esac
}

recovery::main() {
  local command_name=${1:-}
  [[ -n $command_name ]] || {
    recovery::usage >&2
    return 2
  }
  shift

  case "$command_name" in
    -h | --help | help)
      (($# == 0)) || recovery::die "help does not accept options"
      recovery::usage
      ;;
    -V | --version | version)
      (($# == 0)) || recovery::die "version does not accept options"
      recovery::version
      ;;
    phase0)
      recovery::dispatch_phase0 "$@"
      ;;
    *)
      recovery::usage >&2
      recovery::die "unknown command: ${command_name}"
      return 2
      ;;
  esac
}

recovery::main "$@"
