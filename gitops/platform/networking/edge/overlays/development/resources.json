        },
        "name": "development",
        "namespace": "atlas-gateway"
      },
      "spec": {
        "bootstrap": {
          "jsonPatches": [
            {
              "jsonPath": "$.static_resources.clusters[?(@.name == 'xds_cluster')]",
              "op": "add",
              "path": "/dns_lookup_family",
              "value": "V4_ONLY"
            }
          ],
          "type": "JSONPatch"
        },
        "ipFamily": "IPv4",
        "provider": {
          "kubernetes": {
            "envoyDeployment": {
              "container": {
                "image": "docker.io/envoyproxy/envoy:distroless-v1.39.3@sha256:7369b033550a14997e5d698677b7b51f0210a80754f5d084c5caa1a78268267b",
                "resources": {
                  "limits": {
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  }
                }
              },
              "pod": {
                "nodeSelector": {
                  "node-role.local/gateway": "true"
                }
              },
              "replicas": 1
            },
            "envoyService": {
              "externalTrafficPolicy": "Cluster",
              "patch": {
                "type": "StrategicMerge",
                "value": {
                  "spec": {
                    "ports": [
                      {
                        "nodePort": 30080,
                        "port": 80
                      },
                      {
                        "nodePort": 30443,
                        "port": 443
                      }
                    ]
                  }
                }
              },
              "type": "NodePort"
            }
          },
          "type": "Kubernetes"
        }
      }
    },
