#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

preflight_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
readonly preflight_dir
readonly profile_file=${preflight_dir}/personal-local-profile.json
readonly target_schema_file=${preflight_dir}/personal-local-target.schema.json
readonly gate_schema_file=${preflight_dir}/personal-local-owner-gate.schema.json
readonly evidence_schema_file=${preflight_dir}/personal-local-evidence.schema.json
readonly production_contract_file=${preflight_dir}/probe-contract.json
readonly evidence_template=${preflight_dir}/../../../../../../../tests/gitops/fixtures/argo-authorization-probe/valid-personal-local-defined-evidence.json
readonly blocked_exit=24

preflight_tmp=

preflight::_cleanup() {
  if [[ -n ${preflight_tmp:-} && -d $preflight_tmp ]]; then
    rm -rf "$preflight_tmp"
  fi
}
trap preflight::_cleanup EXIT

preflight::_blocked() {
  printf '%s\n' "PERSONAL_LOCAL_BLOCKED: $*" >&2
  exit "$blocked_exit"
}

preflight::_sha256_text() {
  shasum -a 256 | awk '{print $1}'
}

preflight::_sha256_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

preflight::_canonical_sha() {
  local projection
  projection=$(yq -o=json -I=0 'sort_keys(..)' "$1") || return 1
  printf '%s' "$projection" | preflight::_sha256_text
}

preflight::_document_keys() {
  yq -r 'keys | .[]' "$1" | sort
}

preflight::_schema_keys() {
  yq -r '.required[]' "$1" | sort
}

preflight::_assert_exact_keys() {
  [[ $(preflight::_document_keys "$1") == "$(preflight::_schema_keys "$2")" ]]
}

preflight::_assert_input_file() {
  local file=$1
  [[ $file == /* && -f $file && ! -L $file ]]
}

preflight::_capture() {
  local output_name=$1
  shift
  local stderr_file=${preflight_tmp}/command.stderr captured status
  : > "$stderr_file"
  if captured=$("$@" 2> "$stderr_file"); then
    status=0
  else
    status=$?
  fi
  ((status == 0)) || return 1
  [[ ! -s $stderr_file ]] || return 1
  printf -v "$output_name" '%s' "$captured"
}

preflight::_raw_path() {
  local api_version=$1 kind=$2 namespace=$3 name=$4
  [[ $name =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ &&
    (-z $namespace || $namespace =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$) ]] || return 1
  case "${api_version}|${kind}|${namespace}" in
    'v1|Namespace|') printf '/api/v1/namespaces/%s' "$name" ;;
    'v1|ConfigMap|argocd') printf '/api/v1/namespaces/argocd/configmaps/%s' "$name" ;;
    'argoproj.io/v1alpha1|Application|argocd') printf '/apis/argoproj.io/v1alpha1/namespaces/argocd/applications/%s' "$name" ;;
    'argoproj.io/v1alpha1|AppProject|argocd') printf '/apis/argoproj.io/v1alpha1/namespaces/argocd/appprojects/%s' "$name" ;;
    'apps/v1|Deployment|argocd') printf '/apis/apps/v1/namespaces/argocd/deployments/%s' "$name" ;;
    'apps/v1|StatefulSet|argocd') printf '/apis/apps/v1/namespaces/argocd/statefulsets/%s' "$name" ;;
    *) return 1 ;;
  esac
}

preflight::_read_plan() {
  local target=$1 object api_version kind namespace name raw_path
  while IFS= read -r object; do
    api_version=$(yq -r '.apiVersion' <<< "$object") || return 1
    kind=$(yq -r '.kind' <<< "$object") || return 1
    namespace=$(yq -r '.namespace' <<< "$object") || return 1
    name=$(yq -r '.name' <<< "$object") || return 1
    raw_path=$(preflight::_raw_path "$api_version" "$kind" "$namespace" "$name") || return 1
    printf '%s\t%s\t%s\t%s\tget\t%s\n' "$api_version" "$kind" "$namespace" "$name" "$raw_path"
  done < <(yq -o=json -I=0 '.desiredObjects[]' "$target") | sort
}

preflight::_read_plan_sha() {
  local plan
  plan=$(preflight::_read_plan "$1") || return 1
  printf '%s' "$plan" | preflight::_sha256_text
}

preflight::_owner_gate_target_sha() {
  local projection
  projection=$(yq -o=json -I=0 \
    'del(.ownerGateState,.ownerGateSHA256,.ownerGateTargetProjectionSHA256,
      .targetFingerprintSHA256,.approvedTargetDocumentSHA256) | sort_keys(..)' "$1") || return 1
  printf '%s' "$projection" | preflight::_sha256_text
}

preflight::_target_fingerprint() {
  local target=$1 payload
  printf -v payload 'rolloutProfile=%s\nauthorityBaseline=%s\ncontractGitCommit=%s\nenvironmentName=%s\nclusterName=%s\nkubeContext=%s\nkubeconfigPath=%s\nkubeconfigSHA256=%s\nkubectlPath=%s\nkubectlSHA256=%s\nkubectlVersion=%s\nkubernetesVersion=%s\napiServerURL=%s\nkubeSystemNamespaceUID=%s\napiServerCASPKISHA256=%s\nrepositoryURL=%s\nwaiverDecisionSHA256=%s\nownerGateState=%s\nownerGateSHA256=%s\nownerGateTargetProjectionSHA256=%s\n' \
    "$(yq -r '.rolloutProfile' "$target")" "$(yq -r '.authorityBaseline' "$target")" \
    "$(yq -r '.contractGitCommit' "$target")" "$(yq -r '.environmentName' "$target")" \
    "$(yq -r '.clusterName' "$target")" "$(yq -r '.kubeContext' "$target")" \
    "$(yq -r '.kubeconfigPath' "$target")" "$(yq -r '.kubeconfigSHA256' "$target")" \
    "$(yq -r '.kubectlPath' "$target")" "$(yq -r '.kubectlSHA256' "$target")" \
    "$(yq -r '.kubectlVersion' "$target")" "$(yq -r '.kubernetesVersion' "$target")" \
    "$(yq -r '.apiServerURL' "$target")" "$(yq -r '.kubeSystemNamespaceUID' "$target")" \
    "$(yq -r '.apiServerCASPKISHA256' "$target")" "$(yq -r '.repositoryURL' "$target")" \
    "$(yq -r '.waiverDecisionSHA256' "$target")" "$(yq -r '.ownerGateState' "$target")" \
    "$(yq -r '.ownerGateSHA256' "$target")" "$(yq -r '.ownerGateTargetProjectionSHA256' "$target")"
  printf '%s' "$payload" | preflight::_sha256_text
}

preflight::_desired_aggregate_sha() {
  local projection
  projection=$(yq -o=json -I=0 '.desiredObjects | sort_by(.apiVersion,.kind,.namespace,.name) |
    (.. | select(tag == "!!map")) |= sort_keys(.)' "$1") || return 1
  printf '%s' "$projection" | preflight::_sha256_text
}

preflight::_validate_target() {
  local target=$1 expected_commit=$2 profile_sha identities expected_identities approved_projection approved_sha
  preflight::_assert_input_file "$target" || return 1
  yq -e '.' "$target" > /dev/null || return 1
  preflight::_assert_exact_keys "$target" "$target_schema_file" || return 1
  profile_sha=$(preflight::_canonical_sha "$profile_file") || return 1
  [[ $expected_commit =~ ^[0-9a-f]{40}$ &&
    $(yq -r '.schemaVersion' "$target") == 1 &&
    $(yq -r '.rolloutProfile' "$target") == PERSONAL_LOCAL &&
    $(yq -r '.contractGitCommit' "$target") == "$expected_commit" &&
    $(yq -r '.authorityBaseline' "$target") == 48867ada7a38e551098b5c698ddfefc899d9b09e &&
    $(yq -r '.repositoryURL' "$target") == https://github.com/snkio027/atlas.git &&
    $(yq -r '.waiverDecisionSHA256' "$target") == "$profile_sha" &&
    $(yq -r '.kubectlVersion' "$target") == 1.36.3 &&
    $(yq -r '.kubernetesVersion' "$target") == 1.36.1 &&
    $(yq -r '.kubeconfigPath' "$target") == /* &&
    $(yq -r '.kubectlPath' "$target") == /* &&
    $(yq -r '.kubeconfigSHA256' "$target") =~ ^[0-9a-f]{64}$ &&
    $(yq -r '.kubectlSHA256' "$target") =~ ^[0-9a-f]{64}$ &&
    $(yq -r '.apiServerURL' "$target") =~ ^https://[^[:space:]]+$ &&
    $(yq -r '.kubeSystemNamespaceUID' "$target") =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ &&
    $(yq -r '.apiServerCASPKISHA256' "$target") =~ ^[0-9a-f]{64}$ &&
    $(yq -r '.ownerGateSHA256' "$target") =~ ^[0-9a-f]{64}$ ]] || return 1
  case $(yq -r '.ownerGateState' "$target") in
    NOT_AUTHORIZED | APPROVED) ;;
    *) return 1 ;;
  esac
  [[ $(yq '.desiredObjects | length' "$target") -eq 13 &&
  $(yq '[.desiredObjects[] | [.apiVersion,.kind,.namespace,.name] | @tsv] | unique | length' "$target") -eq 13 ]] || return 1
  identities=$(yq -r '.desiredObjects[] | [.apiVersion,.kind,.namespace,.name] | @tsv' "$target" | sort) || return 1
  expected_identities=$(yq -r '.kubernetesReadContract.objects[] | [.apiVersion,.kind,.namespace,.name] | @tsv' "$production_contract_file" | sort) || return 1
  [[ $identities == "$expected_identities" ]] || return 1
  preflight::_read_plan "$target" > /dev/null || return 1
  [[ $(preflight::_owner_gate_target_sha "$target") == "$(yq -r '.ownerGateTargetProjectionSHA256' "$target")" &&
  $(preflight::_target_fingerprint "$target") == "$(yq -r '.targetFingerprintSHA256' "$target")" &&
  $(preflight::_desired_aggregate_sha "$target") == "$(yq -r '.desiredProjectionSHA256' "$target")" ]] || return 1
  approved_projection=$(yq -o=json -I=0 'del(.approvedTargetDocumentSHA256) | sort_keys(..)' "$target") || return 1
  approved_sha=$(printf '%s' "$approved_projection" | preflight::_sha256_text) || return 1
  [[ $approved_sha == "$(yq -r '.approvedTargetDocumentSHA256' "$target")" ]]
}

preflight::_validate_gate() {
  local gate=$1 target=$2 expected_gate_sha=$3 require_approved=$4 gate_sha now
  preflight::_assert_input_file "$gate" || return 1
  [[ $expected_gate_sha =~ ^[0-9a-f]{64}$ ]] || return 1
  yq -e '.' "$gate" > /dev/null || return 1
  preflight::_assert_exact_keys "$gate" "$gate_schema_file" || return 1
  gate_sha=$(preflight::_canonical_sha "$gate") || return 1
  [[ $gate_sha == "$expected_gate_sha" &&
    $gate_sha == "$(yq -r '.ownerGateSHA256' "$target")" &&
    $(yq -r '.schemaVersion' "$gate") == 1 &&
    $(yq -r '.gateID' "$gate") == atlas.argocd.authorization-personal-local-owner-gate/v1 &&
    $(yq -r '.operation' "$gate") == PERSONAL_LOCAL_READ_ONLY_PREFLIGHT &&
    $(yq -r '.rolloutProfile' "$gate") == PERSONAL_LOCAL &&
    $(yq -r '.contractGitCommit' "$gate") == "$(yq -r '.contractGitCommit' "$target")" &&
    $(yq -r '.authorityBaseline' "$gate") == "$(yq -r '.authorityBaseline' "$target")" &&
    $(yq -r '.waiverDecisionSHA256' "$gate") == "$(yq -r '.waiverDecisionSHA256' "$target")" &&
    $(yq -r '.ownerGateTargetProjectionSHA256' "$gate") == "$(yq -r '.ownerGateTargetProjectionSHA256' "$target")" &&
    $(yq -r '.desiredProjectionSHA256' "$gate") == "$(yq -r '.desiredProjectionSHA256' "$target")" &&
    $(yq -r '.readPlanSHA256' "$gate") == "$(preflight::_read_plan_sha "$target")" &&
    $(yq -r '.readObjectCount' "$gate") -eq 13 &&
    $(yq -r '.snapshotCount' "$gate") -eq 2 &&
    $(yq -r '.kubeContext' "$gate") == "$(yq -r '.kubeContext' "$target")" &&
    $(yq -r '.kubeconfigSHA256' "$gate") == "$(yq -r '.kubeconfigSHA256' "$target")" &&
    $(yq -r '.apiServerCASPKISHA256' "$gate") == "$(yq -r '.apiServerCASPKISHA256' "$target")" &&
    $(yq -r '.issuedAt' "$gate") < "$(yq -r '.expiresAt' "$gate")" ]] || return 1
  case $(yq -r '.decision' "$gate") in
    NOT_AUTHORIZED) [[ $(yq -r '.ownerGateState' "$target") == NOT_AUTHORIZED ]] || return 1 ;;
    APPROVED)
      [[ $(yq -r '.ownerGateState' "$target") == APPROVED ]] || return 1
      if [[ $require_approved == true ]]; then
        now=$(date -u +%Y-%m-%dT%H:%M:%SZ) || return 1
        [[ $now > "$(yq -r '.issuedAt' "$gate")" && $now < "$(yq -r '.expiresAt' "$gate")" ]] || return 1
      fi
      ;;
    *) return 1 ;;
  esac
}

preflight::_git() {
  env -i PATH="$PATH" LC_ALL=C git --no-replace-objects -c core.fsmonitor=false -c core.ignoreStat=false "$@"
}

preflight::_hydrate_desired() {
  local target=$1 output_dir=$2 repository_root source_root combined object api kind namespace name count projection sha index=0
  repository_root=$(preflight::_git -C "$preflight_dir" rev-parse --show-toplevel) || return 1
  [[ $repository_root == "${preflight_dir%/gitops/platform/management/protection-foundation/definitions/argo-hardening/probe-contract}" ]] || return 1
  [[ $(preflight::_git -C "$repository_root" rev-parse --verify 'HEAD^{commit}') == "$(yq -r '.contractGitCommit' "$target")" ]] || return 1
  source_root=${preflight_tmp}/source
  mkdir -p "$source_root" "$output_dir" || return 1
  preflight::_git -C "$repository_root" archive "$(yq -r '.contractGitCommit' "$target")" | tar -x -C "$source_root" || return 1
  combined=${preflight_tmp}/desired.yaml
  (
    cd "$source_root" || exit 1
    {
      printf '%s\n' 'apiVersion: v1' 'kind: Namespace' 'metadata:' '  name: kube-system' '---'
      "$(yq -r '.kubectlPath' "$target")" kustomize gitops/platform/management/protection-foundation/definitions/argo-hardening/argocd-self-base-overlay
      printf '%s\n' '---'
      "$(yq -r '.kubectlPath' "$target")" kustomize gitops/platform/management/protection-foundation/definitions/argo-hardening
      printf '%s\n' '---'
      "$(yq -r '.kubectlPath' "$target")" kustomize gitops/platform/management/projects
      printf '%s\n' '---'
      yq '.' bootstrap/argocd/atlas-bootstrap-project.yaml
      printf '%s\n' '---'
      helm template atlas-argocd vendor/charts/argo-cd-10.3.3 --namespace argocd --include-crds \
        --values gitops/platform/management/argocd-self/values.yaml \
        --values gitops/platform/management/protection-foundation/definitions/argo-hardening/argocd-values-hardening.yaml
    }
  ) > "$combined" || return 1
  while IFS= read -r object; do
    api=$(yq -r '.apiVersion' <<< "$object") || return 1
    kind=$(yq -r '.kind' <<< "$object") || return 1
    namespace=$(yq -r '.namespace' <<< "$object") || return 1
    name=$(yq -r '.name' <<< "$object") || return 1
    count=$(API=$api KIND=$kind NS=$namespace NAME=$name yq ea \
      '[select(.apiVersion == strenv(API) and .kind == strenv(KIND) and
      (.metadata.namespace // "") == strenv(NS) and .metadata.name == strenv(NAME))] | length' \
      "$combined" | tail -1) || return 1
    [[ $count -eq 1 ]] || return 1
    projection=$(API=$api KIND=$kind NS=$namespace NAME=$name yq ea -o=json -I=0 \
      'select(.apiVersion == strenv(API) and .kind == strenv(KIND) and
      (.metadata.namespace // "") == strenv(NS) and .metadata.name == strenv(NAME)) |
      del(.metadata.creationTimestamp,.metadata.resourceVersion,.metadata.uid,
      .metadata.generation,.metadata.managedFields,.status) | sort_keys(..)' "$combined") || return 1
    sha=$(printf '%s' "$projection" | preflight::_sha256_text) || return 1
    [[ $sha == "$(yq -r '.desiredProjectionSHA256' <<< "$object")" ]] || return 1
    printf '%s' "$projection" > "${output_dir}/${index}.json" || return 1
    index=$((index + 1))
  done < <(yq -o=json -I=0 '.desiredObjects | sort_by(.apiVersion,.kind,.namespace,.name)[]' "$target")
  ((index == 13))
}

preflight::_validate_local_authority() {
  local target=$1 kubectl_path kubeconfig_path output
  [[ -z ${KUBECONFIG+x} && -z ${ARGOCD_AUTH_TOKEN+x} && -z ${ARGOCD_SERVER+x} && -z ${ARGOCD_OPTS+x} ]] || return 1
  kubectl_path=$(yq -r '.kubectlPath' "$target") || return 1
  kubeconfig_path=$(yq -r '.kubeconfigPath' "$target") || return 1
  [[ -x $kubectl_path && -f $kubectl_path && ! -L $kubectl_path &&
    -f $kubeconfig_path && ! -L $kubeconfig_path ]] || return 1
  [[ $(preflight::_sha256_file "$kubectl_path") == "$(yq -r '.kubectlSHA256' "$target")" &&
  $(preflight::_sha256_file "$kubeconfig_path") == "$(yq -r '.kubeconfigSHA256' "$target")" ]] || return 1
  preflight::_capture output "$kubectl_path" version --client -o json || return 1
  [[ $(yq -r '.clientVersion.gitVersion' <<< "$output") == "v$(yq -r '.kubectlVersion' "$target")" ]] || return 1
  preflight::_capture output "$kubectl_path" --kubeconfig "$kubeconfig_path" config view --minify \
    --context "$(yq -r '.kubeContext' "$target")" -o json || return 1
  [[ $(yq -r '."current-context"' <<< "$output") == "$(yq -r '.kubeContext' "$target")" &&
  $(yq -r '.clusters | length' <<< "$output") -eq 1 &&
  $(yq -r '.clusters[0].cluster.server' <<< "$output") == "$(yq -r '.apiServerURL' "$target")" ]]
}

preflight::_kubectl_raw() {
  local target=$1 path=$2 output_name=$3 output
  preflight::_capture output "$(yq -r '.kubectlPath' "$target")" \
    --kubeconfig "$(yq -r '.kubeconfigPath' "$target")" \
    --context "$(yq -r '.kubeContext' "$target")" \
    --request-timeout=10s get --raw "$path" || return 1
  [[ -n $output ]] || return 1
  printf -v "$output_name" '%s' "$output"
}

preflight::_project_live() {
  local desired=$1 live=$2 marker masked shallow desired_lengths live_lengths
  marker="__REQUIRED_LEAF_${RANDOM}_${RANDOM}__"
  masked=$(MARKER=$marker yq -o=json -I=0 \
    '(.. | select(tag != "!!map" and tag != "!!seq")) = strenv(MARKER)' "$desired") || return 1
  masked=$(yq ea -o=json -I=0 'select(fileIndex == 0) *?d select(fileIndex == 1)' \
    <(printf '%s' "$masked") "$live") || return 1
  [[ $masked != *"$marker"* ]] || return 1
  shallow=$(yq ea -o=json -I=0 'select(fileIndex == 0) *? select(fileIndex == 1)' "$desired" "$live") || return 1
  desired_lengths=$(yq -r '.. | select(tag == "!!seq") | [(path | join("/")), length] | @tsv' \
    "$desired" | sort) || return 1
  live_lengths=$(yq -r '.. | select(tag == "!!seq") | [(path | join("/")), length] | @tsv' \
    <<< "$shallow" | sort) || return 1
  [[ $desired_lengths == "$live_lengths" ]] || return 1
  yq ea -o=json -I=0 'select(fileIndex == 0) *?d select(fileIndex == 1) | sort_keys(..)' "$desired" "$live"
}

preflight::_snapshot() {
  local phase=$1 target=$2 desired_dir=$3 object api kind namespace name desired_sha raw live live_file projection sha index=0
  while IFS= read -r object; do
    api=$(yq -r '.apiVersion' <<< "$object") || return 1
    kind=$(yq -r '.kind' <<< "$object") || return 1
    namespace=$(yq -r '.namespace' <<< "$object") || return 1
    name=$(yq -r '.name' <<< "$object") || return 1
    desired_sha=$(yq -r '.desiredProjectionSHA256' <<< "$object") || return 1
    raw=$(preflight::_raw_path "$api" "$kind" "$namespace" "$name") || return 1
    preflight::_kubectl_raw "$target" "$raw" live || return 1
    live_file=${preflight_tmp}/live-${phase}-${index}.json
    printf '%s' "$live" > "$live_file" || return 1
    yq -e '.' "$live_file" > /dev/null || return 1
    [[ $(yq -r '.apiVersion' "$live_file") == "$api" &&
    $(yq -r '.kind' "$live_file") == "$kind" &&
    $(yq -r '.metadata.namespace // ""' "$live_file") == "$namespace" &&
    $(yq -r '.metadata.name' "$live_file") == "$name" ]] || return 1
    if [[ $kind == Namespace && $name == kube-system ]]; then
      [[ $(yq -r '.metadata.uid' "$live_file") == "$(yq -r '.kubeSystemNamespaceUID' "$target")" ]] || return 1
    fi
    projection=$(preflight::_project_live "${desired_dir}/${index}.json" "$live_file") || return 1
    sha=$(printf '%s' "$projection" | preflight::_sha256_text) || return 1
    [[ $sha == "$desired_sha" ]] || return 1
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$api" "$kind" "${namespace:-@cluster}" "$name" "$desired_sha" "$sha"
    index=$((index + 1))
  done < <(yq -o=json -I=0 '.desiredObjects | sort_by(.apiVersion,.kind,.namespace,.name)[]' "$target")
  ((index == 13))
}

preflight::_snapshot_aggregate() {
  local snapshot=$1 docs=${preflight_tmp}/aggregate.yaml api kind record_namespace namespace name desired_sha live_sha first=true projection
  : > "$docs"
  while IFS=$'\t' read -r api kind record_namespace name desired_sha live_sha; do
    namespace=$record_namespace
    [[ $namespace == @cluster ]] && namespace=''
    if [[ $first == false ]]; then printf '%s\n' '---' >> "$docs"; fi
    first=false
    API=$api KIND=$kind NS=$namespace NAME=$name SHA=$live_sha yq -n -o=json -I=0 \
      '{"apiVersion":strenv(API),"kind":strenv(KIND),"namespace":strenv(NS),
      "name":strenv(NAME),"desiredProjectionSHA256":strenv(SHA)}' >> "$docs" || return 1
  done < "$snapshot"
  projection=$(yq ea -o=json -I=0 '[.] | sort_by(.apiVersion,.kind,.namespace,.name) |
    (.. | select(tag == "!!map")) |= sort_keys(.)' "$docs") || return 1
  printf '%s' "$projection" | preflight::_sha256_text
}

preflight::_build_evidence() {
  local target=$1 gate=$2 before=$3 after=$4 output=$5 started_at=$6 completed_at=$7
  local objects=${preflight_tmp}/objects.yaml reads=${preflight_tmp}/reads.yaml before_sha after_sha object
  before_sha=$(preflight::_snapshot_aggregate "$before") || return 1
  after_sha=$(preflight::_snapshot_aggregate "$after") || return 1
  [[ $before_sha == "$(yq -r '.desiredProjectionSHA256' "$target")" && $after_sha == "$before_sha" ]] || return 1
  : > "$objects"
  local first=true api kind record_namespace namespace name desired_sha before_object_sha after_object_sha
  while IFS=$'\t' read -r api kind record_namespace name desired_sha before_object_sha; do
    namespace=$record_namespace
    [[ $namespace == @cluster ]] && namespace=''
    after_object_sha=$(awk -F '\t' -v api="$api" -v kind="$kind" -v ns="$record_namespace" -v name="$name" \
      '$1==api && $2==kind && $3==ns && $4==name {print $6}' "$after")
    [[ $after_object_sha == "$desired_sha" ]] || return 1
    if [[ $first == false ]]; then printf '%s\n' '---' >> "$objects"; fi
    first=false
    API=$api KIND=$kind NS=$namespace NAME=$name DESIRED=$desired_sha BEFORE=$before_object_sha AFTER=$after_object_sha \
      yq -n -o=json -I=0 '{"apiVersion":strenv(API),"kind":strenv(KIND),"namespace":strenv(NS),
      "name":strenv(NAME),"desiredProjectionSHA256":strenv(DESIRED),
      "liveBeforeProjectionSHA256":strenv(BEFORE),"liveAfterProjectionSHA256":strenv(AFTER)}' >> "$objects" || return 1
  done < "$before"
  : > "$reads"
  first=true
  for phase in BEFORE AFTER; do
    while IFS=$'\t' read -r api kind record_namespace name desired_sha before_object_sha; do
      namespace=$record_namespace
      [[ $namespace == @cluster ]] && namespace=''
      if [[ $first == false ]]; then printf '%s\n' '---' >> "$reads"; fi
      first=false
      PHASE=$phase API=$api KIND=$kind NS=$namespace NAME=$name yq -n -o=json -I=0 \
        '{"phase":strenv(PHASE),"apiVersion":strenv(API),"kind":strenv(KIND),
        "namespace":strenv(NS),"name":strenv(NAME),"verb":"get","status":"READY"}' >> "$reads" || return 1
    done < "$before"
  done
  # shellcheck disable=SC2016 # yq expression variables are populated through strenv/load.
  TARGET=$target OBJECTS=$objects READS=$reads STARTED=$started_at COMPLETED=$completed_at \
    SESSION=$(yq -r '.sessionID' "$gate") BEFORE=$before_sha AFTER=$after_sha yq -o=json -I=2 \
    'load(strenv(TARGET)) as $target |
    .executionMode = "LIVE_READ_ONLY_PREFLIGHT" |
    .contractGitCommit = $target.contractGitCommit |
    .authorityBaseline = $target.authorityBaseline |
    .sessionID = strenv(SESSION) | .startedAt = strenv(STARTED) | .completedAt = strenv(COMPLETED) |
    .target = {"environmentName":$target.environmentName,"clusterName":$target.clusterName,
      "targetFingerprintSHA256":$target.targetFingerprintSHA256,
      "apiServerCASPKISHA256":$target.apiServerCASPKISHA256,
      "waiverDecisionSHA256":$target.waiverDecisionSHA256,
      "ownerGateState":$target.ownerGateState,"ownerGateSHA256":$target.ownerGateSHA256,
      "ownerGateTargetProjectionSHA256":$target.ownerGateTargetProjectionSHA256,
      "approvedTargetDocumentSHA256":$target.approvedTargetDocumentSHA256,
      "desiredProjectionSHA256":$target.desiredProjectionSHA256} |
    .liveProjection.liveBeforeSHA256 = strenv(BEFORE) |
    .liveProjection.liveAfterSHA256 = strenv(AFTER) |
    .liveProjection.objects = load(strenv(OBJECTS)) |
    .liveProjection.status = "MATCH" |
    .kubernetesReads = load(strenv(READS)) |
    .completeness = {"plannedObjects":13,"snapshotCount":2,"expectedReads":26,
      "executedReads":26,"skippedReads":0,"secretReads":0,"collectionReads":0,
      "argoAPICalls":0,"mutations":0} |
    .result = "PERSONAL_LOCAL_READY"' "$evidence_template" > "$output"
}

preflight::_validate_evidence() {
  local evidence=$1 target=$2 gate=$3 expected_reads actual_reads expected_objects actual_objects desired_sha
  preflight::_assert_input_file "$evidence" || return 1
  yq -e '.' "$evidence" > /dev/null || return 1
  preflight::_assert_exact_keys "$evidence" "$evidence_schema_file" || return 1
  desired_sha=$(yq -r '.desiredProjectionSHA256' "$target") || return 1
  [[ $(yq -r '.schemaVersion' "$evidence") == 1 &&
  $(yq -r '.contractID' "$evidence") == atlas.argocd.authorization-personal-local-preflight/v1 &&
  $(yq -r '.rolloutProfile' "$evidence") == PERSONAL_LOCAL &&
  $(yq -r '.executionMode' "$evidence") == LIVE_READ_ONLY_PREFLIGHT &&
  $(yq -r '.contractGitCommit' "$evidence") == "$(yq -r '.contractGitCommit' "$target")" &&
  $(yq -r '.authorityBaseline' "$evidence") == "$(yq -r '.authorityBaseline' "$target")" &&
  $(yq -r '.sessionID' "$evidence") == "$(yq -r '.sessionID' "$gate")" &&
  $(yq -r '.startedAt' "$evidence") > "$(yq -r '.issuedAt' "$gate")" &&
  $(yq -r '.completedAt' "$evidence") < "$(yq -r '.expiresAt' "$gate")" &&
  $(yq -r '.target.targetFingerprintSHA256' "$evidence") == "$(yq -r '.targetFingerprintSHA256' "$target")" &&
  $(yq -r '.target.waiverDecisionSHA256' "$evidence") == "$(yq -r '.waiverDecisionSHA256' "$target")" &&
  $(yq -r '.target.ownerGateState' "$evidence") == APPROVED &&
  $(yq -r '.target.ownerGateSHA256' "$evidence") == "$(yq -r '.ownerGateSHA256' "$target")" &&
  $(yq -r '.target.ownerGateTargetProjectionSHA256' "$evidence") == "$(yq -r '.ownerGateTargetProjectionSHA256' "$target")" &&
  $(yq -r '.target.approvedTargetDocumentSHA256' "$evidence") == "$(yq -r '.approvedTargetDocumentSHA256' "$target")" &&
  $(yq -r '.target.desiredProjectionSHA256' "$evidence") == "$desired_sha" &&
  $(yq -r '.liveProjection.desiredProjectionSHA256' "$evidence") == "$desired_sha" &&
  $(yq -r '.liveProjection.liveBeforeSHA256' "$evidence") == "$desired_sha" &&
  $(yq -r '.liveProjection.liveAfterSHA256' "$evidence") == "$desired_sha" &&
  $(yq -r '.liveProjection.status' "$evidence") == MATCH &&
  $(yq -r '.result' "$evidence") == PERSONAL_LOCAL_READY &&
  $(yq -r '.assurance.argoAPIAuthorization' "$evidence") == RUNTIME_UNPROVEN &&
  $(yq -r '.assurance.productionRecovery' "$evidence") == NOT_AUTHORIZED &&
  $(yq -r '.completeness.plannedObjects' "$evidence") -eq 13 &&
  $(yq -r '.completeness.snapshotCount' "$evidence") -eq 2 &&
  $(yq -r '.completeness.expectedReads' "$evidence") -eq 26 &&
  $(yq -r '.completeness.executedReads' "$evidence") -eq 26 &&
  $(yq -r '.completeness.skippedReads' "$evidence") -eq 0 &&
  $(yq -r '.completeness.secretReads' "$evidence") -eq 0 &&
  $(yq -r '.completeness.collectionReads' "$evidence") -eq 0 &&
  $(yq -r '.completeness.argoAPICalls' "$evidence") -eq 0 &&
  $(yq -r '.completeness.mutations' "$evidence") -eq 0 ]] || return 1
  expected_objects=$(yq -r '.desiredObjects[] | [.apiVersion,.kind,.namespace,.name,.desiredProjectionSHA256,
    .desiredProjectionSHA256,.desiredProjectionSHA256] | @tsv' "$target" | sort) || return 1
  actual_objects=$(yq -r '.liveProjection.objects[] | [.apiVersion,.kind,.namespace,.name,.desiredProjectionSHA256,
    .liveBeforeProjectionSHA256,.liveAfterProjectionSHA256] | @tsv' "$evidence" | sort) || return 1
  [[ $actual_objects == "$expected_objects" ]] || return 1
  expected_reads=$(
    for phase in BEFORE AFTER; do
      preflight::_read_plan "$target" | awk -F '\t' -v phase="$phase" \
        'BEGIN {OFS="\t"} {print phase,$1,$2,$3,$4,$5,"READY"}'
    done | sort
  ) || return 1
  actual_reads=$(yq -r '.kubernetesReads[] | [.phase,.apiVersion,.kind,.namespace,.name,.verb,.status] | @tsv' "$evidence" | sort) || return 1
  [[ $actual_reads == "$expected_reads" ]]
}

preflight::_usage() {
  printf '%s\n' \
    'usage:' \
    '  personal-local-preflight run --target FILE --owner-gate FILE --expected-owner-gate-sha SHA --expected-commit SHA --output FILE' \
    '  personal-local-preflight validate --target FILE --owner-gate FILE --expected-owner-gate-sha SHA --expected-commit SHA --evidence FILE'
}

preflight::_main() {
  local command=${1:-} target='' gate='' expected_gate_sha='' expected_commit='' evidence='' output=''
  [[ -n $command ]] || {
    preflight::_usage >&2
    exit 2
  }
  shift
  while (($#)); do
    case $1 in
      --target)
        (($# >= 2)) || preflight::_blocked 'missing Target path'
        target=$2
        shift 2
        ;;
      --owner-gate)
        (($# >= 2)) || preflight::_blocked 'missing Owner Gate path'
        gate=$2
        shift 2
        ;;
      --expected-owner-gate-sha)
        (($# >= 2)) || preflight::_blocked 'missing external Owner Gate SHA'
        expected_gate_sha=$2
        shift 2
        ;;
      --expected-commit)
        (($# >= 2)) || preflight::_blocked 'missing expected commit'
        expected_commit=$2
        shift 2
        ;;
      --evidence)
        (($# >= 2)) || preflight::_blocked 'missing Evidence path'
        evidence=$2
        shift 2
        ;;
      --output)
        (($# >= 2)) || preflight::_blocked 'missing output path'
        output=$2
        shift 2
        ;;
      *) preflight::_blocked "unknown argument: $1" ;;
    esac
  done
  preflight_tmp=$(mktemp -d "${TMPDIR:-/tmp}/atlas-personal-local-preflight.XXXXXX") || preflight::_blocked 'temporary workspace unavailable'
  [[ -n $target && -n $gate && -n $expected_gate_sha && -n $expected_commit ]] || preflight::_blocked 'incomplete authority inputs'
  preflight::_validate_target "$target" "$expected_commit" || preflight::_blocked 'Target validation failed'
  preflight::_validate_gate "$gate" "$target" "$expected_gate_sha" true || preflight::_blocked 'Owner Gate validation failed'
  case $command in
    run)
      [[ -n $output && -z $evidence && $output == /* && ! -e $output && ! -L $output ]] || preflight::_blocked 'invalid output boundary'
      preflight::_validate_local_authority "$target" || preflight::_blocked 'local target authority validation failed'
      local server_version started_at completed_at desired_dir=${preflight_tmp}/desired before=${preflight_tmp}/before.tsv after=${preflight_tmp}/after.tsv output_tmp
      preflight::_hydrate_desired "$target" "$desired_dir" || preflight::_blocked 'Git desired hydration failed'
      preflight::_kubectl_raw "$target" /version server_version || preflight::_blocked 'Kubernetes version read failed'
      [[ $(yq -r '.gitVersion' <<< "$server_version") == "v$(yq -r '.kubernetesVersion' "$target")" ]] || preflight::_blocked 'Kubernetes version drifted'
      started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) || preflight::_blocked 'clock unavailable'
      preflight::_snapshot BEFORE "$target" "$desired_dir" > "$before" || preflight::_blocked 'before snapshot failed'
      preflight::_snapshot AFTER "$target" "$desired_dir" > "$after" || preflight::_blocked 'after snapshot failed'
      completed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) || preflight::_blocked 'clock unavailable'
      output_tmp=$(mktemp "${output}.tmp.XXXXXX") || preflight::_blocked 'output staging failed'
      chmod 0600 "$output_tmp" || preflight::_blocked 'output custody failed'
      preflight::_build_evidence "$target" "$gate" "$before" "$after" "$output_tmp" "$started_at" "$completed_at" || preflight::_blocked 'Evidence construction failed'
      preflight::_validate_evidence "$output_tmp" "$target" "$gate" || preflight::_blocked 'generated Evidence validation failed'
      mv "$output_tmp" "$output" || preflight::_blocked 'Evidence commit failed'
      printf '%s\n' PERSONAL_LOCAL_READY
      ;;
    validate)
      [[ -n $evidence && -z $output ]] || preflight::_blocked 'invalid validator arguments'
      preflight::_validate_local_authority "$target" || preflight::_blocked 'local target authority validation failed'
      preflight::_hydrate_desired "$target" "${preflight_tmp}/desired" || preflight::_blocked 'Git desired hydration failed'
      preflight::_validate_evidence "$evidence" "$target" "$gate" || preflight::_blocked 'Evidence validation failed'
      printf '%s\n' PERSONAL_LOCAL_READY
      ;;
    *)
      preflight::_usage >&2
      exit 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  preflight::_main "$@"
fi
