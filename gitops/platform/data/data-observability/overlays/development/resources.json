{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "data": {
        "loki.yaml": "apiVersion: 1\ndatasources:\n  - name: Loki\n    uid: loki\n    type: loki\n    access: proxy\n    url: http://loki.platform-logging.svc.cluster.local:3100\n    isDefault: false\n    editable: false\n"
      },
      "kind": "ConfigMap",
      "metadata": {
        "labels": {
          "grafana_datasource": "1"
        },
        "name": "loki-datasource",
        "namespace": "platform-monitoring"
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "labels": {
          "release": "atlas-monitoring"
        },
        "name": "loki",
        "namespace": "platform-monitoring"
      },
      "spec": {
        "endpoints": [
          {
            "interval": "30s",
            "port": "http"
          }
        ],
        "namespaceSelector": {
          "matchNames": [
            "platform-logging"
          ]
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "loki"
          }
        }
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "labels": {
          "release": "atlas-monitoring"
        },
        "name": "alloy",
        "namespace": "platform-monitoring"
      },
      "spec": {
        "endpoints": [
          {
            "interval": "30s",
            "port": "http"
          }
        ],
        "namespaceSelector": {
          "matchNames": [
            "platform-logging"
          ]
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "alloy"
          }
        }
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "PrometheusRule",
      "metadata": {
        "labels": {
          "release": "atlas-monitoring"
        },
        "name": "data-platform",
        "namespace": "platform-monitoring"
      },
      "spec": {
        "groups": [
          {
            "name": "data-platform",
            "rules": [
              {
                "alert": "DataPlatformPodNotReady",
                "annotations": {
                  "summary": "Data platform Pod is not Ready; functional protocol checks are separate."
                },
                "expr": "kube_pod_status_ready{namespace=~\"postgresql|redis|kafka|flink|logging\",condition=\"false\"} == 1",
                "for": "5m",
                "labels": {
                  "severity": "warning"
                }
              },
              {
                "alert": "DataPlatformVolumeAlmostFull",
                "annotations": {
                  "summary": "Data platform PVC has less than 15% free space."
                },
                "expr": "kubelet_volume_stats_available_bytes{namespace=~\"postgresql|redis|kafka|flink|logging\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"postgresql|redis|kafka|flink|logging\"} \u003c 0.15",
                "for": "5m",
                "labels": {
                  "severity": "warning"
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "kind": "List"
}
