# Non-secret environment hydration for the local OrbStack profile.
ATLAS_ENVIRONMENT=local-orbstack
ATLAS_CLUSTER_NAME=atlas-local
ATLAS_KUBE_CONTEXT=kind-atlas-local
ATLAS_KIND_CONFIG=clusters/kind/local-orbstack.yaml
ATLAS_GIT_REPO_URL=https://github.com/snkio027/atlas.git
ATLAS_GIT_REVISION=main
ATLAS_ROOT_PATH=gitops/root/overlays/local-orbstack
ATLAS_ROOT_NAME=atlas-root
ATLAS_REGISTRY_NAME=atlas-registry
ATLAS_REGISTRY_HOST=localhost
ATLAS_REGISTRY_PORT=5001
ATLAS_KUBECTL_TIMEOUT=20s
ATLAS_READY_TIMEOUT=300s
