{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Delete=false,Prune=false"
        },
        "labels": {
          "atlas.local/class": "platform",
          "atlas.local/domain": "observability",
          "atlas.local/owner": "platform",
          "kubernetes.io/metadata.name": "platform-monitoring",
          "pod-security.kubernetes.io/enforce": "privileged"
        },
        "name": "platform-monitoring"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "platform-budget",
        "namespace": "platform-monitoring"
      },
      "spec": {
        "hard": {
          "limits.memory": "8Gi",
          "persistentvolumeclaims": "8",
          "pods": "32",
          "requests.cpu": "3",
          "requests.memory": "4Gi",
          "requests.storage": "32Gi"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "name": "defaults",
        "namespace": "platform-monitoring"
      },
      "spec": {
        "limits": [
          {
            "default": {
              "memory": "256Mi"
            },
            "defaultRequest": {
              "cpu": "10m",
              "memory": "32Mi"
            },
            "type": "Container"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "monitoring-ingress",
        "namespace": "platform-monitoring"
      },
      "spec": {
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "platform-monitoring"
                  }
                },
                "podSelector": {
                  "matchLabels": {}
                }
              }
            ]
          }
        ],
        "podSelector": {
          "matchExpressions": [
            {
              "key": "app.kubernetes.io/name",
              "operator": "In",
              "values": [
                "prometheus",
                "alertmanager",
                "grafana",
                "prometheus-node-exporter",
                "kube-state-metrics"
              ]
            }
          ]
        },
        "policyTypes": [
          "Ingress"
        ]
      }
    }
  ],
  "kind": "List"
}
