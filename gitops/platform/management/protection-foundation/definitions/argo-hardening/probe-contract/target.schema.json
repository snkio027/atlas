{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/argocd-authorization-probe-target-v1.json",
  "title": "Atlas target-bound Argo authorization probe input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractGitCommit",
    "authorityBaseline",
    "environmentName",
    "clusterName",
    "kubeContext",
    "kubeconfigPath",
    "kubeconfigSHA256",
    "apiServerURL",
    "kubeSystemNamespaceUID",
    "apiServerCASPKISHA256",
    "repositoryURL",
    "argocdServerAddress",
    "argocdTLSServerName",
    "argocdServerCertificateSHA256",
    "argocdClientVersion",
    "argocdClientImage",
    "identityCategory",
    "identityDecisionSHA256",
    "expectedSubjectSHA256",
    "expectedIssuerSHA256",
    "expectedClaimsSHA256",
    "credentialReferenceSHA256",
    "targetFingerprintSHA256",
    "desiredObjects",
    "desiredProjectionSHA256",
    "approvedTargetDocumentSHA256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorityBaseline": {"const": "5a8bd5f5b9d547f82bcd6a86c2038c3805e6752f"},
    "environmentName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "clusterName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
    "kubeContext": {"type": "string", "minLength": 1, "maxLength": 253},
    "kubeconfigPath": {"type": "string", "pattern": "^/", "minLength": 2},
    "kubeconfigSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "apiServerURL": {"type": "string", "pattern": "^https://\\S+$"},
    "kubeSystemNamespaceUID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "apiServerCASPKISHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositoryURL": {"const": "https://github.com/snkio027/atlas.git"},
    "argocdServerAddress": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$"},
    "argocdTLSServerName": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
    "argocdServerCertificateSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "argocdClientVersion": {"const": "3.5.1"},
    "argocdClientImage": {"const": "quay.io/argoproj/argocd:v3.5.1@sha256:0deb1a1c917629b960ead995ae3b6069450a866992676599658687ef9a641ee8"},
    "identityCategory": {"enum": ["EXISTING_IDENTITY", "TEMPORARY_PROBE_IDENTITY"]},
    "identityDecisionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectedSubjectSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectedIssuerSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectedClaimsSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "credentialReferenceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetFingerprintSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desiredObjects": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/objectProjection"}
    },
    "desiredProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approvedTargetDocumentSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "objectProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "namespace", "name", "desiredProjectionSHA256"],
      "properties": {
        "apiVersion": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "namespace": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "desiredProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
