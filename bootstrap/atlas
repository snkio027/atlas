#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

if ((BASH_VERSINFO[0] < 5)); then
  printf 'Atlas Bootstrap requires Bash 5.x; found %s\n' "$BASH_VERSION" >&2
  exit 2
fi

ATLAS_ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
readonly ATLAS_ROOT_DIR
ATLAS_STATE_DIR="${ATLAS_ROOT_DIR}/.state"
readonly ATLAS_STATE_DIR
readonly ATLAS_CLI_VERSION=0.1.0

# shellcheck source=bootstrap/lib/runtime.sh
source "${ATLAS_ROOT_DIR}/bootstrap/lib/runtime.sh"
# shellcheck source=bootstrap/lib/lock.sh
source "${ATLAS_ROOT_DIR}/bootstrap/lib/lock.sh"
# shellcheck source=bootstrap/lib/config.sh
source "${ATLAS_ROOT_DIR}/bootstrap/lib/config.sh"
# shellcheck source=bootstrap/host/doctor.sh
source "${ATLAS_ROOT_DIR}/bootstrap/host/doctor.sh"
# shellcheck source=bootstrap/cluster/kind.sh
source "${ATLAS_ROOT_DIR}/bootstrap/cluster/kind.sh"
# shellcheck source=bootstrap/registry/local.sh
source "${ATLAS_ROOT_DIR}/bootstrap/registry/local.sh"
# shellcheck source=bootstrap/argocd/render.sh
source "${ATLAS_ROOT_DIR}/bootstrap/argocd/render.sh"
# shellcheck source=bootstrap/argocd/seed.sh
source "${ATLAS_ROOT_DIR}/bootstrap/argocd/seed.sh"
# shellcheck source=bootstrap/argocd/handoff.sh
source "${ATLAS_ROOT_DIR}/bootstrap/argocd/handoff.sh"
# shellcheck source=bootstrap/argocd/status.sh
source "${ATLAS_ROOT_DIR}/bootstrap/argocd/status.sh"

cli::usage() {
  cat << 'EOF'
Usage: bootstrap/atlas <command> [options]

Commands:
  doctor              Run read-only host and immutable-input checks
  render              Render Argo CD Seed and External Root into .state/
  apply               Ensure the substrate and perform the GitOps handoff
  status              Read the current Bootstrap and handoff state

Options:
  --env <name>         Environment profile (default: local-orbstack)
  --approve-tier0      Explicitly authorize initial Tier-0 instantiation
  -V, --version        Show the Bootstrap CLI version
  -h, --help           Show this help
EOF
}

cli::version() {
  printf 'atlas-bootstrap %s\n' "$ATLAS_CLI_VERSION"
}

command_name=${1:-}
[[ -n $command_name ]] || {
  cli::usage >&2
  exit 2
}
shift

case "$command_name" in
  -h | --help | help)
    (($# == 0)) || runtime::die "help does not accept options"
    cli::usage
    exit 0
    ;;
  -V | --version | version)
    (($# == 0)) || runtime::die "version does not accept options"
    cli::version
    exit 0
    ;;
  doctor | render | apply | status) ;;
  *)
    cli::usage >&2
    runtime::die "unknown command: ${command_name}"
    ;;
esac

environment=local-orbstack
tier0_approved=false
while (($# > 0)); do
  case "$1" in
    --env)
      (($# >= 2)) || runtime::die "--env requires a value"
      environment=$2
      shift 2
      ;;
    --approve-tier0)
      tier0_approved=true
      shift
      ;;
    -h | --help)
      cli::usage
      exit 0
      ;;
    -V | --version)
      cli::version
      exit 0
      ;;
    *) runtime::die "unknown option: $1" ;;
  esac
done

[[ $environment =~ ^[a-z0-9][a-z0-9-]*$ ]] || runtime::die "invalid environment name: ${environment}"
if [[ $command_name == apply ]]; then
  [[ $tier0_approved == true ]] || runtime::die "Tier-0 approval is required: pass --approve-tier0"
else
  [[ $tier0_approved == false ]] || runtime::die "--approve-tier0 is valid only with apply"
fi
config::load "$ATLAS_ROOT_DIR" "$environment"

trap 'status=$?; runtime::on_exit "$status"; exit "$status"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

case "$command_name" in
  doctor)
    host::doctor
    ;;
  render)
    lock::acquire "$ATLAS_STATE_DIR"
    argocd::render
    ;;
  apply)
    lock::acquire "$ATLAS_STATE_DIR"
    host::doctor
    cluster::ensure_kind
    registry::ensure_local
    argocd::handoff "$tier0_approved"
    ;;
  status)
    cluster::inspect_status || true
    registry::inspect_status || true
    if runtime::kind_cluster_exists "$(config::get ATLAS_CLUSTER_NAME)"; then
      argocd::inspect_status || true
    else
      cluster_query_status=$?
      if ((cluster_query_status == 1)); then
        printf 'argocd\tABSENT\tcluster absent\n'
        printf 'root\tABSENT\tcluster absent\n'
        printf 'argocd-self\tABSENT\tcluster absent\n'
      else
        printf 'argocd\tUNAVAILABLE\tcluster status unavailable\n'
        printf 'root\tUNAVAILABLE\tcluster status unavailable\n'
        printf 'argocd-self\tUNAVAILABLE\tcluster status unavailable\n'
      fi
    fi
    ;;
esac
