readonly gate_schema_file=${materialization_dir}/personal-local-target-materialization-owner-gate-v1.schema.json
readonly evidence_schema_file=${materialization_dir}/personal-local-target-materialization-evidence-v1.schema.json
readonly claim_schema_file=${materialization_dir}/personal-local-target-materialization-claim-v1.schema.json
readonly blocked_exit=24
readonly waiver_sha=c70520051531935249298bb5b0fe714a987b1ae1de3ceaee8e939c4d7153be6a
readonly plan_sha=b9f2f0f2a171e410d20d15c5582408185fa8bc7b440442c965230301ccd379dc
readonly authority_baseline=165fb2a31068e3de2ac1064dbf8f95966ff8aad1
