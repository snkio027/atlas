{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "postgresql.cnpg.io/v1",
      "kind": "Cluster",
      "metadata": {
        "name": "postgresql",
        "namespace": "postgresql",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Delete=false,Prune=confirm"
        }
      },
      "spec": {
        "instances": 1,
        "imageName": "ghcr.io/cloudnative-pg/postgresql:18.6@sha256:899d3ed526b659d77935dde0e6bf2d69dbbf17d3d8c6486ca8cfd04bd3c18533",
        "imagePullPolicy": "IfNotPresent",
        "enableSuperuserAccess": false,
        "bootstrap": {
          "initdb": {
            "database": "platform",
            "owner": "platform",
            "secret": {
              "name": "postgresql-app"
            }
          }
        },
        "storage": {
          "size": "8Gi",
          "storageClass": "atlas-local-retain",
          "resizeInUseVolumes": true
        },
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "256Mi"
          },
          "limits": {
            "memory": "1Gi"
          }
        },
        "affinity": {
          "nodeSelector": {
            "node-role.local/data": "true"
          },
          "enablePodAntiAffinity": false,
          "tolerations": [
            {
              "key": "node-role.local/data",
              "operator": "Equal",
              "value": "true",
              "effect": "NoSchedule"
            }
          ]
        },
        "postgresql": {
          "parameters": {
            "shared_buffers": "128MB",
            "max_connections": "50"
          },
          "pg_hba": [
            "hostnossl all all all reject",
            "hostssl all all all scram-sha-256"
          ]
        },
        "inheritedMetadata": {
          "annotations": {
            "argocd.argoproj.io/sync-options": "Delete=false,Prune=confirm"
          }
        },
        "enablePDB": true,
        "failoverDelay": 0,
        "logLevel": "info",
        "maxSyncReplicas": 0,
        "minSyncReplicas": 0,
        "postgresGID": 26,
        "postgresUID": 26,
        "primaryUpdateMethod": "restart",
        "primaryUpdateStrategy": "unsupervised",
        "replicationSlots": {
          "highAvailability": {
            "enabled": true,
            "slotPrefix": "_cnpg_"
          },
          "updateInterval": 30
        },
        "smartShutdownTimeout": 180,
        "startDelay": 3600,
        "stopDelay": 1800,
        "switchoverDelay": 3600
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "database-access",
        "namespace": "postgresql"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "cnpg.io/cluster": "postgresql"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "atlas.local/data-admin": "postgresql"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          },
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "cloudnative-pg"
                  }
                }
              },
              {
                "podSelector": {
                  "matchLabels": {
                    "cnpg.io/cluster": "postgresql"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8000
              },
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          }
        ],
        "egress": [
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 443
              },
              {
                "protocol": "TCP",
                "port": 6443
              }
            ]
          },
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "cnpg.io/cluster": "postgresql"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          }
        ]
      }
    }
  ]
}
