    },
    {
      "name": "clusters",
      "readOnly": ["get"],
      "sideEffecting": ["create", "update", "delete"]
    },
    {
      "name": "projects",
      "readOnly": ["get"],
      "sideEffecting": ["create", "update", "delete"]
    },
    {
      "name": "repositories",
      "readOnly": ["get"],
      "sideEffecting": ["create", "update", "delete"]
    },
    {
      "name": "accounts",
      "readOnly": ["get"],
      "sideEffecting": ["update"]
    },
    {
      "name": "certificates",
      "readOnly": ["get"],
      "sideEffecting": ["create", "delete"]
    },
    {
      "name": "gpgkeys",
      "readOnly": ["get"],
      "sideEffecting": ["create", "delete"]
