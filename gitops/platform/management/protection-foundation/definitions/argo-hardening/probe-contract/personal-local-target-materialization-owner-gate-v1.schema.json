{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/argocd-authorization-personal-local-target-materialization-owner-gate-v1.json",
  "title": "Atlas PERSONAL_LOCAL target materialization Owner Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateID",
    "operation",
    "decision",
    "rolloutProfile",
    "profileID",
    "contractGitCommit",
    "authorityBaseline",
    "repositoryURL",
    "waiverDecisionSHA256",
    "materializationPlanID",
    "materializationPlanSHA256",
    "materializationEvidenceSchemaID",
    "environmentName",
    "clusterName",
    "kubeContext",
    "kubeconfigPath",
    "kubectlPath",
    "kubectlVersion",
    "kubernetesVersion",
    "sessionReceiptRoot",
    "sessionID",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "gateID": {"const": "atlas.argocd.authorization-personal-local-target-materialization-owner-gate/v1"},
    "operation": {"const": "PERSONAL_LOCAL_TARGET_MATERIALIZATION"},
    "decision": {"enum": ["NOT_AUTHORIZED", "APPROVED"]},
    "rolloutProfile": {"const": "PERSONAL_LOCAL"},
    "profileID": {"const": "atlas.argocd.authorization-probe-profile/personal-local/v2"},
    "contractGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorityBaseline": {"const": "165fb2a31068e3de2ac1064dbf8f95966ff8aad1"},
    "repositoryURL": {"const": "https://github.com/snkio027/atlas.git"},
    "waiverDecisionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materializationPlanID": {"const": "atlas.argocd.authorization-personal-local-target-materialization-plan/v1"},
    "materializationPlanSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materializationEvidenceSchemaID": {"const": "atlas.argocd.authorization-personal-local-target-materialization-evidence/v1"},
    "environmentName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "clusterName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
    "kubeContext": {"type": "string", "minLength": 1, "maxLength": 253},
    "kubeconfigPath": {"type": "string", "pattern": "^/", "minLength": 2},
    "kubectlPath": {"type": "string", "pattern": "^/", "minLength": 2},
    "kubectlVersion": {"const": "1.36.3"},
    "kubernetesVersion": {"const": "1.36.1"},
    "sessionReceiptRoot": {"type": "string", "pattern": "^/", "minLength": 2},
    "sessionID": {"type": "string", "pattern": "^personal-local-materialization-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
