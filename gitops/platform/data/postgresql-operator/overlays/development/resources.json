{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "operator-control",
        "namespace": "platform-cnpg-operator"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 443,
                "protocol": "TCP"
              },
              {
                "port": 6443,
                "protocol": "TCP"
              }
            ]
          },
          {
            "ports": [
              {
                "port": 8000,
                "protocol": "TCP"
              },
              {
                "port": 5432,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "service-postgresql"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "cnpg.io/cluster": "postgresql"
                  }
                }
              }
            ]
          }
        ],
        "ingress": [
          {
            "ports": [
              {
                "port": 9443,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "cloudnative-pg"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    }
  ],
  "kind": "List"
}
