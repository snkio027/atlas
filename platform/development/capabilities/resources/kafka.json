            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 9090
              },
              {
                "protocol": "TCP",
                "port": 9091
              },
              {
                "protocol": "TCP",
                "port": 9093
              }
            ]
          },
          {
            "ports": [
              {
                "protocol": "TCP",
