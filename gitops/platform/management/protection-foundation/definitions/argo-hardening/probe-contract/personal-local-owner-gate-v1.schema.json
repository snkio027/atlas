{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/argocd-authorization-personal-local-owner-gate-v1.json",
  "title": "Atlas PERSONAL_LOCAL read-only preflight Owner Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateID",
    "operation",
    "decision",
    "rolloutProfile",
    "contractGitCommit",
    "authorityBaseline",
    "waiverDecisionSHA256",
    "ownerGateTargetProjectionSHA256",
    "desiredProjectionSHA256",
    "readPlanSHA256",
    "readObjectCount",
    "snapshotCount",
    "kubeContext",
    "kubeconfigSHA256",
    "apiServerCASPKISHA256",
    "sessionID",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "gateID": {"const": "atlas.argocd.authorization-personal-local-owner-gate/v1"},
    "operation": {"const": "PERSONAL_LOCAL_READ_ONLY_PREFLIGHT"},
    "decision": {"enum": ["NOT_AUTHORIZED", "APPROVED"]},
    "rolloutProfile": {"const": "PERSONAL_LOCAL"},
    "contractGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorityBaseline": {"const": "48867ada7a38e551098b5c698ddfefc899d9b09e"},
    "waiverDecisionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ownerGateTargetProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desiredProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readPlanSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readObjectCount": {"const": 13},
    "snapshotCount": {"const": 2},
    "kubeContext": {"type": "string", "minLength": 1, "maxLength": 253},
    "kubeconfigSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "apiServerCASPKISHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessionID": {"type": "string", "pattern": "^personal-local-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"},
    "issuedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expiresAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
