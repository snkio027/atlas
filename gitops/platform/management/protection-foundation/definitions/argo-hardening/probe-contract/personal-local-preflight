#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

readonly blocked_exit=24

preflight::_usage() {
  printf '%s\n' \
    'usage:' \
    '  personal-local-preflight run --target FILE --owner-gate FILE --expected-owner-gate-sha SHA --expected-commit SHA --output FILE' \
    '  personal-local-preflight validate --target FILE --owner-gate FILE --expected-owner-gate-sha SHA --expected-commit SHA --evidence FILE'
}

preflight::_main() {
  case ${1:-} in
    run | validate)
      printf '%s\n' 'PERSONAL_LOCAL_BLOCKED: PERSONAL_LOCAL profile v1 is never live-eligible' >&2
      exit "$blocked_exit"
      ;;
    *)
      preflight::_usage >&2
      exit 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  preflight::_main "$@"
fi
