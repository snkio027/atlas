{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "monitoring",
        "labels": {
          "atlas.local/owner": "platform",
          "pod-security.kubernetes.io/enforce": "privileged"
        },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "platform-budget",
        "namespace": "monitoring"
      },
      "spec": {
        "hard": {
          "requests.cpu": "3",
          "requests.memory": "4Gi",
          "limits.memory": "8Gi",
          "requests.storage": "32Gi",
          "persistentvolumeclaims": "8",
          "pods": "32"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "name": "defaults",
        "namespace": "monitoring"
      },
      "spec": {
        "limits": [
          {
            "type": "Container",
            "default": {
              "memory": "256Mi"
            },
            "defaultRequest": {
              "cpu": "10m",
              "memory": "32Mi"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "monitoring-ingress",
        "namespace": "monitoring"
      },
      "spec": {
        "podSelector": {
          "matchExpressions": [
            {
              "key": "app.kubernetes.io/name",
              "operator": "In",
              "values": [
                "prometheus",
                "alertmanager",
                "grafana",
                "prometheus-node-exporter",
                "kube-state-metrics"
              ]
            }
          ]
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "monitoring"
                  }
                },
                "podSelector": {
                  "matchLabels": {}
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
