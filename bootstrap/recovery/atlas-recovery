#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

if ((BASH_VERSINFO[0] < 5)); then
  printf 'Atlas Recovery requires Bash 5.x; found %s\n' "$BASH_VERSION" >&2
  exit 2
fi

ATLAS_RECOVERY_ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
readonly ATLAS_RECOVERY_ROOT_DIR
readonly ATLAS_RECOVERY_CLI_VERSION=0.2.0

# Recovery code is intentionally sourced only by this entry point. The normal
# Bootstrap CLI must remain unable to dispatch recovery behavior.
# shellcheck source=bootstrap/recovery/audit-config.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/audit-config.sh"
# shellcheck source=bootstrap/recovery/principal-identity.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/principal-identity.sh"
# shellcheck source=bootstrap/recovery/admission-canary/render.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/admission-canary/render.sh"
# shellcheck source=bootstrap/recovery/session-authorization-canary/render.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/session-authorization-canary/render.sh"
# shellcheck source=bootstrap/recovery/canary-session.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/canary-session.sh"
# shellcheck source=bootstrap/recovery/canary-ceremony.sh
source "${ATLAS_RECOVERY_ROOT_DIR}/bootstrap/recovery/canary-ceremony.sh"

recovery::usage() {
  cat << 'EOF'
Usage: bootstrap/recovery/atlas-recovery <command> [options]

Commands:
  phase0 audit-config                 Render an audited Kind configuration
  phase0 admission-canary-manifests  Render the admission escape canary bundle
  phase0 session-authorization-canary-manifests
                                      Render the Fence/Permission canary bundle
  phase0 canary-drill                Run the gated disposable-cluster ceremony

Options for phase0 audit-config:
  --audit-dir <path>  Existing writable audit directory outside the repository

Options for phase0 admission-canary-manifests:
  --recovery-operator <username>
                      Exact atlas:break-glass:<kube-system-UID>:g<N> username

Options for phase0 session-authorization-canary-manifests:
  --recovery-operator <username>
                      Exact atlas:break-glass:<kube-system-UID>:g<N> username
  --session-authorizer <username>
                      Exact atlas:session-authz:<kube-system-UID>:g<N>

Options for phase0 canary-drill (all required):
  --cluster-name <name>               Canonical disposable drill cluster
  --context <context>                 Exact kind-<cluster-name> context
  --admin-kubeconfig <path>           Isolated cluster-admin kubeconfig
  --audit-dir <path>                  Cluster audit directory
  --creation-evidence <path>          Reviewed cluster-creation evidence
  --evidence-root <path>              Empty-session runtime evidence root
  --credential-dir <path>             Empty short-lived credential directory
  --storage-assertion <value>         encrypted-owner-controlled
  --known-good-revision <commit>      Full reviewed clean Git commit
  --recovery-generation <N>          Current Recovery Operator generation
  --previous-recovery-generation <N> Previous Recovery Operator generation
  --authorizer-generation <N>        Current Session Authorizer generation
  --previous-authorizer-generation <N>
                                      Previous Session Authorizer generation

Global options:
  -V, --version        Show the Recovery CLI version
  -h, --help           Show this help

The canary drill can mutate only an independently created, audited disposable
cluster after an exact interactive Human Judgment Gate. It cannot create or
delete a cluster, target the normal Atlas cluster, activate production names,
modify GitOps or Tier-0, or perform Receipt recovery.
EOF
}

recovery::version() {
  printf 'atlas-recovery %s\n' "$ATLAS_RECOVERY_CLI_VERSION"
}

recovery::die() {
  printf 'atlas-recovery: %s\n' "$*" >&2
  return 1
}

recovery::dispatch_canary_drill() {
  local option key
  declare -A values=() seen=()
  readonly -A option_names=(
    [cluster_name]=--cluster-name
    [context]=--context
    [admin_kubeconfig]=--admin-kubeconfig
    [audit_directory]=--audit-dir
    [creation_evidence]=--creation-evidence
    [evidence_root]=--evidence-root
    [credential_directory]=--credential-dir
    [storage_assertion]=--storage-assertion
    [known_good_revision]=--known-good-revision
    [recovery_generation]=--recovery-generation
    [previous_recovery_generation]=--previous-recovery-generation
    [authorizer_generation]=--authorizer-generation
    [previous_authorizer_generation]=--previous-authorizer-generation
  )
  while (($# > 0)); do
    option=$1
    case "$option" in
      --cluster-name) key=cluster_name ;;
      --context) key=context ;;
      --admin-kubeconfig) key=admin_kubeconfig ;;
      --audit-dir) key=audit_directory ;;
      --creation-evidence) key=creation_evidence ;;
      --evidence-root) key=evidence_root ;;
      --credential-dir) key=credential_directory ;;
      --storage-assertion) key=storage_assertion ;;
      --known-good-revision) key=known_good_revision ;;
      --recovery-generation) key=recovery_generation ;;
      --previous-recovery-generation) key=previous_recovery_generation ;;
      --authorizer-generation) key=authorizer_generation ;;
      --previous-authorizer-generation) key=previous_authorizer_generation ;;
      *)
        recovery::die "unknown canary-drill option: ${option}"
        return 2
        ;;
    esac
    [[ -z ${seen[$key]+present} ]] || {
      recovery::die "duplicate canary-drill option: ${option}"
      return 2
    }
    (($# >= 2)) || {
      recovery::die "${option} requires a value"
      return 2
    }
    [[ -n $2 && $2 != --* ]] || {
      recovery::die "${option} requires a non-option value"
      return 2
    }
    seen[$key]=1
    values[$key]=$2
    shift 2
  done
  for key in cluster_name context admin_kubeconfig audit_directory creation_evidence \
    evidence_root credential_directory storage_assertion known_good_revision \
    recovery_generation previous_recovery_generation authorizer_generation \
    previous_authorizer_generation; do
    [[ -n ${values[$key]+present} ]] || {
      recovery::die "canary-drill requires ${option_names[$key]}"
      return 2
    }
  done
  phase0_ceremony::run "${values[cluster_name]}" "${values[context]}" \
    "${values[admin_kubeconfig]}" "${values[audit_directory]}" \
    "${values[creation_evidence]}" "${values[evidence_root]}" \
    "${values[credential_directory]}" "${values[storage_assertion]}" \
    "${values[known_good_revision]}" "${values[recovery_generation]}" \
    "${values[previous_recovery_generation]}" "${values[authorizer_generation]}" \
    "${values[previous_authorizer_generation]}"
}

recovery::dispatch_phase0() {
  local action=${1:-}
  [[ -n $action ]] || {
    recovery::die "phase0 requires an action"
    return 2
  }
  shift

  case "$action" in
    audit-config)
      audit::dispatch "$action" "$@"
      ;;
    admission-canary-manifests)
      admission_canary::dispatch "$@"
      ;;
    session-authorization-canary-manifests)
      session_canary::dispatch "$@"
      ;;
    canary-drill)
      recovery::dispatch_canary_drill "$@"
      ;;
    *)
      recovery::die "unknown phase0 action: ${action}"
      return 2
      ;;
  esac
}

recovery::main() {
  local command_name=${1:-}
  [[ -n $command_name ]] || {
    recovery::usage >&2
    return 2
  }
  shift

  case "$command_name" in
    -h | --help | help)
      (($# == 0)) || recovery::die "help does not accept options"
      recovery::usage
      ;;
    -V | --version | version)
      (($# == 0)) || recovery::die "version does not accept options"
      recovery::version
      ;;
    phase0)
      recovery::dispatch_phase0 "$@"
      ;;
    *)
      recovery::usage >&2
      recovery::die "unknown command: ${command_name}"
      return 2
      ;;
  esac
}

recovery::main "$@"
