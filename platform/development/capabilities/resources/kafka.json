        "storage": {
          "type": "jbod",
          "volumes": [
            {
              "id": 0,
              "type": "persistent-claim",
              "size": "8Gi",
              "class": "atlas-local-retain",
              "deleteClaim": false,
              "kraftMetadata": "shared"
            }
          ]
        },
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "512Mi"
          },
          "limits": {
            "memory": "1Gi"
          }
        },
        "template": {
          "pod": {
            "securityContext": {
              "runAsNonRoot": true,
              "fsGroup": 1001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "affinity": {
              "nodeAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": {
                  "nodeSelectorTerms": [
                    {
                      "matchExpressions": [
                        {
                          "key": "node-role.local/data",
                          "operator": "In",
                          "values": [
                            "true"
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "tolerations": [
              {
                "key": "node-role.local/data",
                "operator": "Equal",
                "value": "true",
                "effect": "NoSchedule"
              }
            ]
          },
          "kafkaContainer": {
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        }
      }
