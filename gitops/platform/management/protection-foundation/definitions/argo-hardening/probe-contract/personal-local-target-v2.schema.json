{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/argocd-authorization-personal-local-target-v2.json",
  "title": "Atlas PERSONAL_LOCAL v2 read-only preflight target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rolloutProfile",
    "profileID",
    "contractGitCommit",
    "authorityBaseline",
    "environmentName",
    "clusterName",
    "kubeContext",
    "kubeconfigPath",
    "kubeconfigSHA256",
    "kubectlPath",
    "kubectlSHA256",
    "kubectlVersion",
    "kubernetesVersion",
    "apiServerURL",
    "kubeSystemNamespaceUID",
    "apiServerCASPKISHA256",
    "repositoryURL",
    "waiverDecisionSHA256",
    "targetMaterializationEvidenceSHA256",
    "ownerGateState",
    "ownerGateSHA256",
    "ownerGateTargetProjectionSHA256",
    "targetFingerprintSHA256",
    "desiredObjects",
    "desiredProjectionSHA256",
    "approvedTargetDocumentSHA256"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "rolloutProfile": {"const": "PERSONAL_LOCAL"},
    "profileID": {"const": "atlas.argocd.authorization-probe-profile/personal-local/v2"},
    "contractGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorityBaseline": {"const": "165fb2a31068e3de2ac1064dbf8f95966ff8aad1"},
    "environmentName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "clusterName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
    "kubeContext": {"type": "string", "minLength": 1, "maxLength": 253},
    "kubeconfigPath": {"type": "string", "pattern": "^/", "minLength": 2},
    "kubeconfigSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kubectlPath": {"type": "string", "pattern": "^/", "minLength": 2},
    "kubectlSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kubectlVersion": {"const": "1.36.3"},
    "kubernetesVersion": {"const": "1.36.1"},
    "apiServerURL": {"type": "string", "pattern": "^https://\\S+$"},
    "kubeSystemNamespaceUID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "apiServerCASPKISHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositoryURL": {"const": "https://github.com/snkio027/atlas.git"},
    "waiverDecisionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetMaterializationEvidenceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ownerGateState": {"enum": ["NOT_AUTHORIZED", "APPROVED"]},
    "ownerGateSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ownerGateTargetProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetFingerprintSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desiredObjects": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/objectProjection"}
    },
    "desiredProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approvedTargetDocumentSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "objectProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "namespace", "name", "desiredProjectionSHA256"],
      "properties": {
        "apiVersion": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "namespace": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "desiredProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
