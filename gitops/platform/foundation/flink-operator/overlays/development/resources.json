{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Delete=false,Prune=false"
        },
        "labels": {
          "atlas.local/class": "platform",
          "atlas.local/domain": "processing",
          "atlas.local/owner": "platform",
          "kubernetes.io/metadata.name": "platform-flink-operator",
          "pod-security.kubernetes.io/enforce": "restricted"
        },
        "name": "platform-flink-operator"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "platform-budget",
        "namespace": "platform-flink-operator"
      },
      "spec": {
        "hard": {
          "limits.memory": "1Gi",
          "persistentvolumeclaims": "0",
          "pods": "4",
          "requests.cpu": "500m",
          "requests.memory": "1Gi",
          "requests.storage": "0"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "name": "defaults",
        "namespace": "platform-flink-operator"
      },
      "spec": {
        "limits": [
          {
            "default": {
              "memory": "256Mi"
            },
            "defaultRequest": {
              "cpu": "10m",
              "memory": "32Mi"
            },
            "type": "Container"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "default-deny",
        "namespace": "platform-flink-operator"
      },
      "spec": {
        "egress": [],
        "ingress": [],
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "dns",
        "namespace": "platform-flink-operator"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ]
          }
        ],
        "podSelector": {},
        "policyTypes": [
          "Egress"
        ]
      }
    }
  ],
  "kind": "List"
}
