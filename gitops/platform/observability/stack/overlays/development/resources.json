{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "monitoring.coreos.com/v1alpha1",
      "kind": "AlertmanagerConfig",
      "metadata": {
        "name": "atlas-local-alerts",
        "namespace": "platform-monitoring"
      },
      "spec": {
        "receivers": [
          {
            "name": "local-only"
          }
        ],
        "route": {
          "groupBy": [
            "namespace",
            "alertname"
          ],
          "groupInterval": "5m",
          "groupWait": "30s",
          "receiver": "local-only",
          "repeatInterval": "4h"
        }
      }
    }
  ],
  "kind": "List"
}
