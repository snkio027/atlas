{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/argocd-authorization-personal-local-owner-gate-v2.json",
  "title": "Atlas PERSONAL_LOCAL v2 read-only preflight Owner Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateID",
    "operation",
    "decision",
    "rolloutProfile",
    "profileID",
    "contractGitCommit",
    "authorityBaseline",
    "repositoryURL",
    "waiverDecisionSHA256",
    "targetMaterializationEvidenceSHA256",
    "ownerGateTargetProjectionSHA256",
    "desiredProjectionSHA256",
    "readPlanSHA256",
    "readObjectCount",
    "snapshotCount",
    "kubeContext",
    "kubeconfigSHA256",
    "apiServerCASPKISHA256",
    "sessionID",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "gateID": {"const": "atlas.argocd.authorization-personal-local-owner-gate/v2"},
    "operation": {"const": "PERSONAL_LOCAL_READ_ONLY_PREFLIGHT"},
    "decision": {"enum": ["NOT_AUTHORIZED", "APPROVED"]},
    "rolloutProfile": {"const": "PERSONAL_LOCAL"},
    "profileID": {"const": "atlas.argocd.authorization-probe-profile/personal-local/v2"},
    "contractGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorityBaseline": {"const": "165fb2a31068e3de2ac1064dbf8f95966ff8aad1"},
    "repositoryURL": {"const": "https://github.com/snkio027/atlas.git"},
    "waiverDecisionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetMaterializationEvidenceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ownerGateTargetProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desiredProjectionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readPlanSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readObjectCount": {"const": 13},
    "snapshotCount": {"const": 2},
    "kubeContext": {"type": "string", "minLength": 1, "maxLength": 253},
    "kubeconfigSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "apiServerCASPKISHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessionID": {"type": "string", "pattern": "^personal-local-preflight-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
