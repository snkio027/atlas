{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "data": {
        "config.alloy": "discovery.kubernetes \"pods\" {\n  role = \"pod\"\n  namespaces { names = [\"service-postgresql\", \"service-redis\", \"service-kafka\", \"service-flink-session\", \"project-platform-smoke\"] }\n}\ndiscovery.relabel \"logs\" {\n  targets = discovery.kubernetes.pods.targets\n  rule {\n    source_labels = [\"__meta_kubernetes_namespace\"]\n    target_label = \"namespace\"\n  }\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_name\"]\n    target_label = \"pod\"\n  }\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_container_name\"]\n    target_label = \"container\"\n  }\n}\nloki.source.kubernetes \"pods\" {\n  targets = discovery.relabel.logs.output\n  forward_to = [loki.write.local.receiver]\n}\nloki.write \"local\" {\n  endpoint { url = \"http://loki.platform-logging.svc.cluster.local:3100/loki/api/v1/push\" }\n}\n"
      },
      "kind": "ConfigMap",
      "metadata": {
        "name": "alloy-config",
        "namespace": "platform-logging"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "alloy",
        "namespace": "platform-logging"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "alloy"
        },
        "name": "alloy",
        "namespace": "platform-logging"
      },
      "spec": {
        "ports": [
          {
            "name": "http",
            "port": 12345,
            "targetPort": "http"
          }
        ],
        "selector": {
          "app.kubernetes.io/name": "alloy"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "alloy",
        "namespace": "platform-logging"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "alloy"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "annotations": {
              "checksum/config": "9ff60ba7bb43c6e35e8e8837f6c704a36d067f10237b152cd44cd9d2187031bf"
            },
            "labels": {
              "app.kubernetes.io/name": "alloy"
            }
          },
          "spec": {
            "automountServiceAccountToken": true,
            "containers": [
              {
                "args": [
                  "run",
                  "/config/config.alloy",
                  "--storage.path=/data",
                  "--server.http.listen-addr=0.0.0.0:12345",
                  "--disable-reporting"
                ],
                "image": "docker.io/grafana/alloy:v1.20.1@sha256:2aa2099af76c0098d4af7a4d6e48f86cb66dc1a000222ad927a1c67c6542d13f",
                "livenessProbe": {
                  "failureThreshold": 6,
                  "httpGet": {
                    "path": "/-/ready",
                    "port": "http"
                  },
                  "periodSeconds": 20,
                  "timeoutSeconds": 5
                },
                "name": "alloy",
                "ports": [
                  {
                    "containerPort": 12345,
                    "name": "http"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/-/ready",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "memory": "384Mi"
                  },
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "startupProbe": {
                  "failureThreshold": 60,
                  "httpGet": {
                    "path": "/-/ready",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "volumeMounts": [
                  {
                    "mountPath": "/tmp",
                    "name": "tmp",
                    "readOnly": false
                  },
                  {
                    "mountPath": "/config",
                    "name": "alloy-config",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/data",
                    "name": "data",
                    "readOnly": false
                  }
                ]
              }
            ],
            "nodeSelector": {
              "kubernetes.io/os": "linux",
              "node-role.local/compute": "true"
            },
            "securityContext": {
              "fsGroup": 473,
              "runAsGroup": 473,
              "runAsNonRoot": true,
              "runAsUser": 473,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccountName": "alloy",
            "terminationGracePeriodSeconds": 60,
            "volumes": [
              {
                "emptyDir": {
                  "sizeLimit": "128Mi"
                },
                "name": "tmp"
              },
              {
                "configMap": {
                  "defaultMode": 292,
                  "name": "alloy-config"
                },
                "name": "alloy-config"
              },
              {
                "emptyDir": {
                  "sizeLimit": "128Mi"
                },
                "name": "data"
              }
            ]
          }
        }
      }
    },
