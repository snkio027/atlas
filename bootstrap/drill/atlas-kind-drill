#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

if ((BASH_VERSINFO[0] < 5)); then
  printf 'Atlas Kind Drill requires Bash 5.x; found %s\n' "$BASH_VERSION" >&2
  exit 2
fi

ATLAS_DRILL_ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
readonly ATLAS_DRILL_ROOT_DIR
readonly ATLAS_DRILL_CLI_VERSION=0.1.0

# shellcheck source=bootstrap/drill/contract.sh
source "${ATLAS_DRILL_ROOT_DIR}/bootstrap/drill/contract.sh"
# shellcheck source=bootstrap/drill/lock.sh
source "${ATLAS_DRILL_ROOT_DIR}/bootstrap/drill/lock.sh"
# shellcheck source=bootstrap/drill/evidence.sh
source "${ATLAS_DRILL_ROOT_DIR}/bootstrap/drill/evidence.sh"
# shellcheck source=bootstrap/drill/cluster-create.sh
source "${ATLAS_DRILL_ROOT_DIR}/bootstrap/drill/cluster-create.sh"

drill::usage() {
  cat << 'EOF'
Usage: bootstrap/drill/atlas-kind-drill <command> [options]

Commands:
  create  Create and verify one disposable audited Kind drill cluster

Required create options:
  --cluster-name <name>  Unique atlas-recovery-drill-* cluster name
  --context <name>       Exact context; must equal kind-<cluster-name>
  --kubeconfig <path>    New absolute kubeconfig path outside the repository
  --audit-dir <path>     Existing empty audit directory named after the cluster
  --evidence-root <path> Existing owner-only root for persistent cluster-creation evidence
  --storage-assertion encrypted-owner-controlled
                         Attest encrypted, owner-controlled audit/evidence storage

Global options:
  -V, --version          Show the drill CLI version
  -h, --help             Show this help

Creation requires a journaled, plan-bound Human Judgment challenge. There is
no approval flag, reuse path, delete command, or default-context path.
EOF
}

drill::version() {
  printf 'atlas-kind-drill %s\n' "$ATLAS_DRILL_CLI_VERSION"
}

drill::die() {
  printf 'atlas-kind-drill: %s\n' "$*" >&2
  return 1
}

drill::main() {
  local command_name=${1:-}
  [[ -n $command_name ]] || {
    drill::usage >&2
    return 2
  }
  shift

  case "$command_name" in
    -h | --help | help)
      (($# == 0)) || {
        drill::die "help does not accept options"
        return 2
      }
      drill::usage
      return 0
      ;;
    -V | --version | version)
      (($# == 0)) || {
        drill::die "version does not accept options"
        return 2
      }
      drill::version
      return 0
      ;;
    create) ;;
    *)
      drill::usage >&2
      drill::die "unknown command: ${command_name}"
      return 2
      ;;
  esac

  local cluster_name='' context='' kubeconfig='' audit_directory='' evidence_root='' storage_assertion=''
  while (($# > 0)); do
    case "$1" in
      --cluster-name | --context | --kubeconfig | --audit-dir | --evidence-root | --storage-assertion)
        (($# >= 2)) || {
          drill::die "$1 requires a value"
          return 2
        }
        case "$1" in
          --cluster-name)
            [[ -z $cluster_name ]] || {
              drill::die "$1 may be specified only once"
              return 2
            }
            cluster_name=$2
            ;;
          --context)
            [[ -z $context ]] || {
              drill::die "$1 may be specified only once"
              return 2
            }
            context=$2
            ;;
          --kubeconfig)
            [[ -z $kubeconfig ]] || {
              drill::die "$1 may be specified only once"
              return 2
            }
            kubeconfig=$2
            ;;
          --audit-dir)
            [[ -z $audit_directory ]] || {
              drill::die "$1 may be specified only once"
              return 2
            }
            audit_directory=$2
            ;;
          --evidence-root)
            [[ -z $evidence_root ]] || {
              drill::die "$1 may be specified only once"
              return 2
            }
            evidence_root=$2
            ;;
          --storage-assertion)
            [[ -z $storage_assertion ]] || {
              drill::die "$1 may be specified only once"
              return 2
            }
            storage_assertion=$2
            ;;
        esac
        shift 2
        ;;
      -h | --help)
        drill::usage
        return 0
        ;;
      *)
        drill::die "unknown option: $1"
        return 2
        ;;
    esac
  done

  [[ -n $cluster_name ]] || {
    drill::die "create requires --cluster-name"
    return 2
  }
  [[ -n $context ]] || {
    drill::die "create requires --context"
    return 2
  }
  [[ -n $kubeconfig ]] || {
    drill::die "create requires --kubeconfig"
    return 2
  }
  [[ -n $audit_directory ]] || {
    drill::die "create requires --audit-dir"
    return 2
  }
  [[ -n $evidence_root ]] || {
    drill::die "create requires --evidence-root"
    return 2
  }
  [[ -n $storage_assertion ]] || {
    drill::die "create requires --storage-assertion"
    return 2
  }

  drill::create_cluster "$cluster_name" "$context" "$kubeconfig" "$audit_directory" "$evidence_root" "$storage_assertion"
}

drill::main "$@"
