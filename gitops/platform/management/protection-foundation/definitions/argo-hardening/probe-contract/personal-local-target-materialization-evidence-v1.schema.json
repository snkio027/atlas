{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/argocd-authorization-personal-local-target-materialization-evidence-v1.json",
  "title": "Atlas PERSONAL_LOCAL target materialization evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceID",
    "rolloutProfile",
    "profileID",
    "waiverDecisionSHA256",
    "contractGitCommit",
    "authorityBaseline",
    "repositoryURL",
    "materializationPlanID",
    "materializationPlanSHA256",
    "materializationOwnerGateSHA256",
    "materializationSessionClaimSHA256",
    "sessionID",
    "startedAt",
    "completedAt",
    "environmentName",
    "clusterName",
    "kubeContext",
    "credentialMode",
    "authenticationShape",
    "selectedUserShapeStatus",
    "kubeconfigSHA256",
    "kubectlSHA256",
    "kubectlVersion",
    "kubernetesVersion",
    "apiServerURL",
    "apiServerCASPKISHA256",
    "kubeSystemNamespaceUID",
    "localAuthorityOperations",
    "kubernetesReads",
    "completeness",
    "assurance",
    "result"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "evidenceID": {"const": "atlas.argocd.authorization-personal-local-target-materialization-evidence/v1"},
    "rolloutProfile": {"const": "PERSONAL_LOCAL"},
    "profileID": {"const": "atlas.argocd.authorization-probe-profile/personal-local/v2"},
    "waiverDecisionSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contractGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorityBaseline": {"const": "165fb2a31068e3de2ac1064dbf8f95966ff8aad1"},
    "repositoryURL": {"const": "https://github.com/snkio027/atlas.git"},
    "materializationPlanID": {"const": "atlas.argocd.authorization-personal-local-target-materialization-plan/v1"},
    "materializationPlanSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materializationOwnerGateSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materializationSessionClaimSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessionID": {"type": "string", "pattern": "^personal-local-materialization-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "environmentName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "clusterName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
    "kubeContext": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,252}$"},
    "credentialMode": {"const": "STATIC_IN_KUBECONFIG"},
    "authenticationShape": {"const": "X509_EMBEDDED_DATA"},
    "selectedUserShapeStatus": {"const": "EXACT_X509_EMBEDDED_DATA"},
    "kubeconfigSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kubectlSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kubectlVersion": {"const": "1.36.3"},
    "kubernetesVersion": {"const": "1.36.1"},
    "apiServerURL": {"type": "string", "pattern": "^https://([A-Za-z0-9.-]+|\\[[0-9A-Fa-f:]+\\])(:[0-9]{1,5})?$"},
    "apiServerCASPKISHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kubeSystemNamespaceUID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "localAuthorityOperations": {
      "const": [
        "VALIDATE_OWNER_GATE",
        "ACQUIRE_SESSION_CLAIM",
        "VALIDATE_KUBECONFIG_CUSTODY",
        "HASH_KUBECONFIG",
        "VALIDATE_KUBECTL_CUSTODY",
        "HASH_KUBECTL",
        "VALIDATE_KUBECTL_CLIENT_VERSION",
        "PROJECT_CONTEXT_CLUSTER_AND_USER",
        "PROJECT_CLUSTER_TLS_AUTHORITY",
        "VALIDATE_SELECTED_USER_KEY_SHAPE",
        "COMPUTE_CA_SPKI_SHA256",
        "GET_VERSION",
        "GET_KUBE_SYSTEM_NAMESPACE",
        "REVALIDATE_FILE_CUSTODY_AND_HASHES",
        "BUILD_AND_VALIDATE_EVIDENCE",
        "COMMIT_TERMINAL_RECEIPT"
      ]
    },
    "kubernetesReads": {
      "const": [
        {"ordinal": 1, "method": "GET", "path": "/version"},
        {"ordinal": 2, "method": "GET", "path": "/api/v1/namespaces/kube-system"}
      ]
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedRequests", "executedRequests", "skippedRequests", "collectionReads", "secretReads", "argoAPICalls", "kubernetesMutations", "gitOpsMutations", "runtimeMutations", "unexpectedRequests"],
      "properties": {
        "expectedRequests": {"const": 2},
        "executedRequests": {"const": 2},
        "skippedRequests": {"const": 0},
        "collectionReads": {"const": 0},
        "secretReads": {"const": 0},
        "argoAPICalls": {"const": 0},
        "kubernetesMutations": {"const": 0},
        "gitOpsMutations": {"const": 0},
        "runtimeMutations": {"const": 0},
        "unexpectedRequests": {"const": 0}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argoAPIAuthorization", "productionRecovery"],
      "properties": {
        "argoAPIAuthorization": {"const": "RUNTIME_UNPROVEN"},
        "productionRecovery": {"const": "NOT_AUTHORIZED"}
      }
    },
    "result": {"const": "TARGET_MATERIALIZED"}
  }
}
